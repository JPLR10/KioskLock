<?xml version="1.0" encoding="utf-8"?>
<!-- BlackBox7 kiosk home screen: logo background, clock, app dock at the bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_white">

    <!-- Full BlackBox7 logo as the background (white edges blend with the screen) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_home" />

    <!-- Small stacked logo, top-left. Long-press it to open the admin screen. -->
    <ImageView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo_stacked" />

    <!-- Clock and date, top-right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="@color/bb_black"
            android:textSize="44sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textColor="@color/bb_teal"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Setup / maintenance notice (hidden while the kiosk is locked) -->
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/status_pill"
        android:elevation="6dp"
        android:gravity="center"
        android:maxWidth="560dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="@color/bb_white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- App dock: scrolls sideways if there are more apps than fit -->
    <HorizontalScrollView
        android:id="@+id/dock_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/dock_bg"
        android:elevation="14dp"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp" />
    </HorizontalScrollView>
</FrameLayout>
