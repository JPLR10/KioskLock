<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_white"
    android:orientation="vertical">

    <!-- Header: logo + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/logo_stacked" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/admin_title"
                android:textColor="@color/bb_black"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/bb_teal"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Brand accent line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/bb_red" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="2"
            android:background="@drawable/btn_red"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/save_and_lock"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btn_pin"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_teal"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/change_pin"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_teal"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/exit_kiosk"
            android:textAllCaps="false"
            android:textColor="@color/bb_white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_remove"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/remove_owner"
            android:textAllCaps="false"
            android:textColor="@color/bb_red"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:text="@string/pick_apps"
        android:textAllCaps="true"
        android:textColor="@color/bb_muted"
        android:letterSpacing="0.08"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1400716B"
        android:dividerHeight="1dp"
        android:paddingHorizontal="8dp" />
</LinearLayout>
